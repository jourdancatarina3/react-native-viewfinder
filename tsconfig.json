{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-image-viewfinder": ["./src/index"],
      "react-native-image-viewfinder/expo-image": ["./src/expo-image"],
      "react-native-image-viewfinder/expo-image-manipulator": [
        "./src/expo-image-manipulator"
      ]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "react-native-image-viewfinder-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
